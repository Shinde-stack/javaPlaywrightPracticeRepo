<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ========================================================== -->
    <!-- Maven Project Information                                  -->
    <!-- ========================================================== -->

    <modelVersion>4.0.0</modelVersion>

    <!-- Unique organization/project identifier -->
    <groupId>gid</groupId>

    <!-- Name of this project -->
    <artifactId>playwrightPractice</artifactId>

    <!-- Current project version -->
    <version>0.0.1-SNAPSHOT</version>

    <!-- ========================================================== -->
    <!-- Centralized Version Management                             -->
    <!-- ========================================================== -->

    <!-- All reusable project versions are defined here -->
    <properties>

        <!-- ================= Java Version ================= -->

        <!-- Java language level used by compiler -->
        <java.version>21</java.version>

        <!-- =============== Dependency Versions ============== -->

        <!-- 
            Playwright Java Version 
            Note: Playwright handles browser binary management automatically,
            so WebDriverManager is no longer needed.
        -->
        <playwright.version>1.49.0</playwright.version>

        <testng.version>7.10.2</testng.version>

        <slf4j.version>2.0.12</slf4j.version>

        <log4j2.version>2.23.1</log4j2.version>

        <extentreports.version>5.1.2</extentreports.version>

        <commonsio.version>2.16.1</commonsio.version>

        <!-- ================ Plugin Versions ================= -->

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>

    </properties>

    <!-- ========================================================== -->
    <!-- Project Dependencies                                       -->
    <!-- ========================================================== -->

    <dependencies>

        <!-- ====================================================== -->
        <!-- Playwright Automation                                  -->
        <!-- ====================================================== -->

        <!--
            Playwright Java

            Responsibility
            • Modern browser automation (Chromium, Firefox, WebKit)
            • Auto-waits and resilient selectors
            • Network interception and API testing
            • Isolated browser contexts out-of-the-box
        -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- ====================================================== -->
        <!-- Test Framework                                         -->
        <!-- ====================================================== -->

        <!--
            TestNG

            Scope = test
        -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ====================================================== -->
        <!-- Reporting                                              -->
        <!-- ====================================================== -->

        <!-- ExtentReports -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

        <!-- ====================================================== -->
        <!-- Utilities                                              -->
        <!-- ====================================================== -->

        <!-- Apache Commons IO -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commonsio.version}</version>
        </dependency>

        <!-- ====================================================== -->
        <!-- Logging API                                            -->
        <!-- ====================================================== -->

        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- ====================================================== -->
        <!-- Logging Backend                                        -->
        <!-- ====================================================== -->

        <!-- Log4j2 API -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

        <!-- Log4j2 Core -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

        <!-- SLF4J → Log4j2 Bridge -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

    </dependencies>

    <!-- ========================================================== -->
    <!-- Build Configurations                                       -->
    <!-- ========================================================== -->

    <build>
        <plugins>
            <!-- Maven Compiler Plugin configured with Java 21 properties -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
